<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TestMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestMVC.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <!-- Top Progress Bar for Seamless AJAX Navigation -->
    <div id="appProgressBar"></div>

    <!-- Toast Notifications Container (Right-Top) -->
    <div id="toastContainer"></div>

    <!-- Hidden Site-wide Anti-Forgery Form for AJAX requests -->
    <form id="globalAntiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="app-layout">
            <!-- Left Sidebar Navigation (~20% width) -->
            <aside class="app-sidebar" id="appSidebar">
                <div class="sidebar-header">
                    <a class="sidebar-brand spa-link" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-badge">⚡</span>
                        <div class="brand-details">
                            <span class="brand-title">TestMVC</span>
                            <span class="brand-subtitle">Store Manager</span>
                        </div>
                    </a>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-heading">MAIN MENU</div>
                    <ul class="sidebar-nav" id="mainNavBar">
                        <!-- 1. DashBoard -->
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link spa-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <span class="nav-icon">📊</span>
                                <span class="nav-label">DashBoard</span>
                            </a>
                        </li>
                        <!-- 2. Brands -->
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link spa-link" asp-area="" asp-controller="Brand" asp-action="Index">
                                <span class="nav-icon">🏷️</span>
                                <span class="nav-label">Brands</span>
                            </a>
                        </li>
                        <!-- 3. Categories -->
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link spa-link" asp-area="" asp-controller="Category" asp-action="Index">
                                <span class="nav-icon">📁</span>
                                <span class="nav-label">Categories</span>
                            </a>
                        </li>
                        <!-- 4. Products -->
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link spa-link" asp-area="" asp-controller="Product" asp-action="Index">
                                <span class="nav-icon">📦</span>
                                <span class="nav-label">Products</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="sidebar-footer">
                    <div class="d-flex flex-column gap-2 w-100">
                        <div class="user-pill d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <span class="status-indicator"></span>
                                <span class="user-name fw-bold text-dark">@User.Identity.Name</span>
                            </div>
                        </div>
                        <a asp-controller="Account" asp-action="Logout" data-no-spa class="btn btn-sm btn-outline-danger w-100 py-1 d-flex align-items-center justify-content-center gap-1" style="font-size: 0.85rem;">
                            <span>🚪</span>
                            <span>Logout</span>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- Right Content Area (~80% width) -->
            <div class="app-main-area">
                <!-- Mobile Toggle Header (Visible on small screens only) -->
                <header class="mobile-topbar d-md-none">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="mobileSidebarToggle">
                        ☰ Menu
                    </button>
                    <span class="fw-bold">TestMVC</span>
                </header>

                <main role="main" id="mainContent" class="main-content-container page-fade-in">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="login-fullscreen-layout">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
