<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TestMVC</title>
    <script type="importmap"></script>
    <!-- Prevent Theme Flash -->
    <script>
        (function () {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TestMVC.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <!-- Top Progress Bar for Seamless AJAX Navigation -->
    <div id="appProgressBar"></div>

    <!-- Toast Notifications Container (Right-Top) -->
    <div id="toastContainer"></div>

    <!-- Hidden Site-wide Anti-Forgery Form for AJAX requests -->
    <form id="globalAntiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="app-layout">
            <!-- Left Sidebar Navigation -->
            <aside class="app-sidebar" id="appSidebar">
                <div class="sidebar-header">
                    <a class="sidebar-brand spa-link" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-badge">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 17 12 22 22 17"></polyline>
                                <polyline points="2 12 12 17 22 12"></polyline>
                            </svg>
                        </span>
                        <div class="brand-details">
                            <span class="brand-title">TestMVC</span>
                            <span class="brand-subtitle">Store Manager</span>
                        </div>
                    </a>
                </div>

                <div class="sidebar-section">
                    <div class="sidebar-section-heading">MAIN MENU</div>
                    <ul class="sidebar-nav" id="mainNavBar">
                        <!-- 1. DashBoard -->
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link spa-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="9" rx="1.5"></rect>
                                        <rect x="14" y="3" width="7" height="5" rx="1.5"></rect>
                                        <rect x="14" y="12" width="7" height="9" rx="1.5"></rect>
                                        <rect x="3" y="16" width="7" height="5" rx="1.5"></rect>
                                    </svg>
                                </span>
                                <span class="nav-label">DashBoard</span>
                            </a>
                        </li>
                        <!-- 2. Brands -->
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link spa-link" asp-area="" asp-controller="Brand" asp-action="Index">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                                        <line x1="7" y1="7" x2="7.01" y2="7"></line>
                                    </svg>
                                </span>
                                <span class="nav-label">Brands</span>
                            </a>
                        </li>
                        <!-- 3. Categories -->
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link spa-link" asp-area="" asp-controller="Category" asp-action="Index">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                </span>
                                <span class="nav-label">Categories</span>
                            </a>
                        </li>
                        <!-- 4. Products -->
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link spa-link" asp-area="" asp-controller="Product" asp-action="Index">
                                <span class="nav-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                        <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                                        <line x1="12" y1="22.08" x2="12" y2="12"></line>
                                    </svg>
                                </span>
                                <span class="nav-label">Products</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Sidebar Footer: Theme Toggle, User Profile, & Logout -->
                <div class="sidebar-footer">
                    <!-- Theme Mode Switcher -->
                    <div class="theme-switch-wrap mb-2">
                        <button type="button" class="theme-toggle-btn w-100" id="themeToggleBtn" title="Switch Theme (Light / Dark)">
                            <div class="theme-toggle-content d-flex align-items-center justify-content-between w-100">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="theme-sun-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="5"></circle>
                                            <line x1="12" y1="1" x2="12" y2="3"></line>
                                            <line x1="12" y1="21" x2="12" y2="23"></line>
                                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                            <line x1="1" y1="12" x2="3" y2="12"></line>
                                            <line x1="21" y1="12" x2="23" y2="12"></line>
                                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                                        </svg>
                                    </span>
                                    <span class="theme-moon-icon">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                                        </svg>
                                    </span>
                                    <span class="theme-mode-label fw-semibold">Light Mode</span>
                                </div>
                                <div class="theme-pill-track">
                                    <div class="theme-pill-thumb"></div>
                                </div>
                            </div>
                        </button>
                    </div>

                    <!-- User Information Pill -->
                    <div class="user-pill d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="status-indicator"></span>
                            <span class="user-name">@User.Identity.Name</span>
                        </div>
                        <span class="user-role-badge">Admin</span>
                    </div>

                    <!-- Logout Button -->
                    <a asp-controller="Account" asp-action="Logout" data-no-spa class="btn-logout d-flex align-items-center justify-content-center gap-2 text-decoration-none w-100">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>Logout</span>
                    </a>
                </div>
            </aside>

            <!-- Right Content Area -->
            <div class="app-main-area">
                <!-- Mobile Toggle Header -->
                <header class="mobile-topbar d-md-none">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="mobileSidebarToggle">
                        â˜° Menu
                    </button>
                    <span class="fw-bold">TestMVC</span>
                    <button type="button" class="theme-toggle-btn btn btn-sm btn-outline-secondary p-1" title="Toggle Theme">
                        ðŸŒ“
                    </button>
                </header>

                <main role="main" id="mainContent" class="main-content-container page-fade-in">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="login-fullscreen-layout">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["Success"] != null)
            {
                <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString() ?? "")), 'success');</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString() ?? "")), 'error');</text>
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>