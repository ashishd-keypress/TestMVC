@model List<TestMVC.Models.Expense>
@{
    ViewData["Title"] = "Shop Expenses";
    string? search = ViewBag.Search;
    DateTime now = DateTime.Today;

    // 1. Current Month Expenses (Requirement #3)
    var currentMonthExpenses = Model
        .Where(e => e.ExpenseDate.Year == now.Year && e.ExpenseDate.Month == now.Month)
        .ToList();
    decimal currentMonthTotal = currentMonthExpenses.Sum(e => e.Amount);
    int currentMonthCount = currentMonthExpenses.Count;
    string currentMonthName = now.ToString("MMMM yyyy");

    // 2. Monthly Summaries calculated based on Expense Dates (Requirement #2)
    var monthlySummaries = Model
        .GroupBy(e => new { e.ExpenseDate.Year, e.ExpenseDate.Month })
        .Select(g => new {
            Year = g.Key.Year,
            Month = g.Key.Month,
            MonthDate = new DateTime(g.Key.Year, g.Key.Month, 1),
            MonthName = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMMM yyyy"),
            Total = g.Sum(x => x.Amount),
            Count = g.Count(),
            IsCurrentMonth = (g.Key.Year == now.Year && g.Key.Month == now.Month),
            IsCompleted = (new DateTime(g.Key.Year, g.Key.Month, 1).AddMonths(1) <= now)
        })
        .OrderByDescending(m => m.MonthDate)
        .ToList();

    var completedMonths = monthlySummaries.Where(m => m.IsCompleted).ToList();
    decimal completedMonthsTotal = completedMonths.Sum(m => m.Total);
    decimal allTimeTotal = Model.Sum(e => e.Amount);
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.025em;">Shop Expenses</h2>
            <p class="text-muted small mb-0">Track shop rent, electricity, staff salary, internet, transport, and tea/hospitality.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Record Expense
        </a>
    </div>

    <!-- Expense Stats (Updated immediately on delete without refresh) -->
    <div class="row g-3 mb-4">
        <!-- 1. Total Recorded Expenses (Current Month only) -->
        <div class="col-md-6 col-lg-4">
            <div class="kpi-card kpi-card-product">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="kpi-label">TOTAL RECORDED EXPENSES</span>
                    <span class="badge rounded-pill px-2.5 py-1" id="kpiCurrentMonthBadge" style="background: rgba(99, 102, 241, 0.18); color: #818cf8; font-size: 0.72rem; font-weight: 600;">
                        @currentMonthName
                    </span>
                </div>
                <div class="kpi-number fs-3 text-nowrap" id="kpiCurrentMonthTotal">₹@currentMonthTotal.ToString("N2")</div>
                <div class="small text-muted mt-2" id="kpiCurrentMonthSubtitle">
                    <i class="bi bi-clock-history me-1"></i>@currentMonthCount transactions logged in @currentMonthName
                </div>
            </div>
        </div>

        <!-- 2. Completed Months Summary -->
        <div class="col-md-6 col-lg-4">
            <div class="kpi-card kpi-card-category">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="kpi-label">COMPLETED MONTHS EXPENSES</span>
                    <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(16, 185, 129, 0.18); color: #10b981; font-size: 0.72rem; font-weight: 600;">
                        <i class="bi bi-check-circle-fill me-1"></i>Completed
                    </span>
                </div>
                <div class="kpi-number fs-3 text-nowrap" id="kpiCompletedMonthsTotal">₹@completedMonthsTotal.ToString("N2")</div>
                <div class="small text-muted mt-2" id="kpiCompletedMonthsSubtitle">
                    <i class="bi bi-archive me-1"></i>Total for @completedMonths.Count completed month(s)
                </div>
            </div>
        </div>

        <!-- 3. All-Time Recorded Expenses -->
        <div class="col-md-6 col-lg-4">
            <div class="kpi-card kpi-card-brand">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="kpi-label">ALL-TIME TOTAL EXPENSES</span>
                    <span class="badge rounded-pill px-2.5 py-1" style="background: rgba(148, 163, 184, 0.18); color: #94a3b8; font-size: 0.72rem; font-weight: 600;">
                        All History
                    </span>
                </div>
                <div class="kpi-number fs-3 text-nowrap" id="kpiAllTimeTotal">₹@allTimeTotal.ToString("N2")</div>
                <div class="small text-muted mt-2" id="kpiAllTimeSubtitle">
                    <i class="bi bi-receipt me-1"></i>@Model.Count transactions across all history
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Expense Summary (Completed & Active Months Breakdown) -->
    <div class="card shadow-sm mb-4 border-0" id="monthlyExpenseSummarySection">
        <div class="card-header d-flex justify-content-between align-items-center py-3 bg-transparent border-bottom">
            <div class="d-flex align-items-center gap-2">
                <div class="rounded-3 p-2 d-inline-flex" style="background: rgba(99, 102, 241, 0.12); color: #818cf8;">
                    <i class="bi bi-calendar3 fs-5"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold">Monthly Expense Summary</h6>
                    <small class="text-muted">Calculated totals grouped by completed and active months based on expense dates</small>
                </div>
            </div>
            <span class="badge bg-secondary-subtle text-secondary" id="monthlyExpenseSummaryCount">@monthlySummaries.Count Month(s) Recorded</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="padding-left: 1.25rem;">Month & Year</th>
                            <th>Status</th>
                            <th class="text-center">Transactions</th>
                            <th class="text-end" style="padding-right: 1.25rem;">Total Expenses (₹)</th>
                        </tr>
                    </thead>
                    <tbody id="monthlyExpenseSummaryTbody">
                        @if (monthlySummaries.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <em>No monthly expense data available yet.</em>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var mg in monthlySummaries)
                            {
                                <tr>
                                    <td style="padding-left: 1.25rem;">
                                        <div class="fw-semibold">
                                            <i class="bi bi-calendar-check me-2 text-primary"></i>@mg.MonthName
                                        </div>
                                    </td>
                                    <td>
                                        @if (mg.IsCompleted)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-1.5 fw-semibold">
                                                <i class="bi bi-check-circle-fill me-1"></i>Month Completed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-1.5 fw-semibold">
                                                <i class="bi bi-hourglass-split me-1"></i>Current Month (In Progress)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-body-secondary text-body">@mg.Count @(mg.Count == 1 ? "record" : "records")</span>
                                    </td>
                                    <td class="text-end fw-bold text-danger fs-6" style="padding-right: 1.25rem;">
                                        ₹@mg.Total.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body py-3">
            <form method="get" id="expenseSearchForm" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="expenseSearchInput" name="search" value="@search" class="form-control" placeholder="Search expense description, category..." />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary" id="expenseSearchBtn">Search</button>
                    <button type="button" class="btn btn-outline-secondary" id="expenseResetBtn">Reset</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Expenses Table (Columns: Date, Description, Category, Amount, Actions) -->
    <div class="card shadow-sm border-0">
        <div class="card-header py-3 bg-transparent border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold">
                <i class="bi bi-list-check me-2 text-primary"></i>All Expense Records
            </h6>
            <span class="small text-muted" id="tableExpenseRecordCount">Showing @Model.Count record(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Date</th>
                        <th>Description</th>
                        <th style="width: 190px;">Category</th>
                        <th class="text-end" style="width: 150px;">Amount</th>
                        <th class="text-center" style="width: 170px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="expenseTableBody">
                    @if (Model.Count == 0)
                    {
                        <tr id="noExpensesRow">
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-wallet2 fs-1 d-block mb-2 text-muted"></i>
                                <em>No shop expenses recorded yet.</em>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model)
                        {
                            <tr id="expense-row-@e.ExpenseId" data-expense-id="@e.ExpenseId" data-amount="@e.Amount" data-date="@e.ExpenseDate.ToString("yyyy-MM-dd")">
                                <!-- 1. Date -->
                                <td class="fw-semibold text-nowrap">
                                    <i class="bi bi-calendar-event me-1 text-muted"></i>
                                    @e.ExpenseDate.ToString("yyyy-MM-dd")
                                </td>
                                <!-- 2. Description -->
                                <td>
                                    <div class="fw-semibold">@e.Description</div>
                                    @if (!string.IsNullOrEmpty(e.PaymentMethodName))
                                    {
                                        <small class="text-muted"><i class="bi bi-credit-card me-1"></i>@e.PaymentMethodName</small>
                                    }
                                </td>
                                <!-- 3. Category -->
                                <td>
                                    <span class="badge px-2.5 py-1.5" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-weight: 600;">
                                        @e.CategoryName
                                    </span>
                                </td>
                                <!-- 4. Amount -->
                                <td class="text-end fw-bold text-danger fs-6 text-nowrap">
                                    ₹@e.Amount.ToString("N2")
                                </td>
                                <!-- 5. Actions (Edit & Delete with Confirmation & Live Recalculation) -->
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@e.ExpenseId" class="btn btn-sm btn-outline-primary" title="Edit Expense">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('Expense', @e.ExpenseId, '@Html.Raw(e.Description.Replace("'", "\\'"))', this.closest('tr'))" title="Delete Expense">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Automatic Dynamic Recalculation & DOM Synchronization for Expenses
        window.updateExpenseUI = function (stats) {
            if (!stats) return;

            // 1. Current Month KPI Card
            const elCurrTotal = document.getElementById('kpiCurrentMonthTotal');
            const elCurrSub = document.getElementById('kpiCurrentMonthSubtitle');
            if (elCurrTotal && stats.currentMonthTotalFormatted !== undefined) {
                elCurrTotal.innerText = '₹' + stats.currentMonthTotalFormatted;
            }
            if (elCurrSub && stats.currentMonthName) {
                elCurrSub.innerHTML = `<i class="bi bi-clock-history me-1"></i>${stats.currentMonthCount} transactions logged in ${stats.currentMonthName}`;
            }

            // 2. Completed Months KPI Card
            const elCompTotal = document.getElementById('kpiCompletedMonthsTotal');
            const elCompSub = document.getElementById('kpiCompletedMonthsSubtitle');
            if (elCompTotal && stats.completedMonthsTotalFormatted !== undefined) {
                elCompTotal.innerText = '₹' + stats.completedMonthsTotalFormatted;
            }
            if (elCompSub && stats.completedMonthsCount !== undefined) {
                elCompSub.innerHTML = `<i class="bi bi-archive me-1"></i>Total for ${stats.completedMonthsCount} completed month(s)`;
            }

            // 3. All-Time Recorded Expenses KPI Card
            const elAllTotal = document.getElementById('kpiAllTimeTotal');
            const elAllSub = document.getElementById('kpiAllTimeSubtitle');
            if (elAllTotal && stats.allTimeTotalFormatted !== undefined) {
                elAllTotal.innerText = '₹' + stats.allTimeTotalFormatted;
            }
            if (elAllSub && stats.allTimeCount !== undefined) {
                elAllSub.innerHTML = `<i class="bi bi-receipt me-1"></i>${stats.allTimeCount} transactions across all history`;
            }

            // 4. Monthly Expense Summary Section
            const summaryTbody = document.getElementById('monthlyExpenseSummaryTbody');
            const summaryCount = document.getElementById('monthlyExpenseSummaryCount');

            if (summaryCount && stats.monthlySummaries) {
                summaryCount.innerText = `${stats.monthlySummaries.length} Month(s) Recorded`;
            }

            if (summaryTbody) {
                if (!stats.monthlySummaries || stats.monthlySummaries.length === 0) {
                    summaryTbody.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <em>No monthly expense data available yet.</em>
                            </td>
                        </tr>
                    `;
                } else {
                    summaryTbody.innerHTML = stats.monthlySummaries.map(mg => `
                        <tr>
                            <td style="padding-left: 1.25rem;">
                                <div class="fw-semibold">
                                    <i class="bi bi-calendar-check me-2 text-primary"></i>${mg.monthName}
                                </div>
                            </td>
                            <td>
                                ${mg.isCompleted ? `
                                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-1.5 fw-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i>Month Completed
                                    </span>
                                ` : `
                                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-1.5 fw-semibold">
                                        <i class="bi bi-hourglass-split me-1"></i>Current Month (In Progress)
                                    </span>
                                `}
                            </td>
                            <td class="text-center">
                                <span class="badge bg-body-secondary text-body">${mg.count} ${mg.count === 1 ? 'record' : 'records'}</span>
                            </td>
                            <td class="text-end fw-bold text-danger fs-6" style="padding-right: 1.25rem;">
                                ₹${mg.totalFormatted}
                            </td>
                        </tr>
                    `).join('');
                }
            }

            // 5. Table Record Count Badge
            const tableRecordCount = document.getElementById('tableExpenseRecordCount');
            if (tableRecordCount && stats.allTimeCount !== undefined) {
                tableRecordCount.innerText = `Showing ${stats.allTimeCount} record(s)`;
            }
        };

        (function () {
            const searchForm = document.getElementById('expenseSearchForm');
            const searchInput = document.getElementById('expenseSearchInput');
            const resetBtn = document.getElementById('expenseResetBtn');
            const tbody = document.getElementById('expenseTableBody');
            const countLabel = document.getElementById('tableExpenseRecordCount');

            async function searchExpenses(query) {
                const url = `/api/Expense/expense_list_get?search=${encodeURIComponent(query || '')}`;
                try {
                    const res = await window.apiFetch(url, { method: 'GET' });
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    const json = await res.json();
                    if (!json || !json.success) return;

                    if (json.stats) {
                        window.updateExpenseUI(json.stats);
                    }

                    if (countLabel) {
                        countLabel.innerText = `Showing ${json.data.length} record(s)`;
                    }

                    if (tbody) {
                        if (!json.data || json.data.length === 0) {
                            tbody.innerHTML = `
                                <tr id="noExpensesRow">
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-wallet2 fs-1 d-block mb-2 text-muted"></i>
                                        <em>${query ? `No shop expenses found matching "${escapeHtml(query)}".` : 'No shop expenses recorded yet.'}</em>
                                    </td>
                                </tr>
                            `;
                        } else {
                            tbody.innerHTML = json.data.map(e => {
                                const safeDesc = escapeHtml(e.description || '');
                                const safeDescArg = (e.description || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
                                const payHtml = e.paymentMethodName
                                    ? `<small class="text-muted"><i class="bi bi-credit-card me-1"></i>${escapeHtml(e.paymentMethodName)}</small>`
                                    : '';
                                return `
                                    <tr id="expense-row-${e.expenseId}" data-expense-id="${e.expenseId}" data-amount="${e.amount}" data-date="${e.expenseDate}">
                                        <td class="fw-semibold text-nowrap">
                                            <i class="bi bi-calendar-event me-1 text-muted"></i>
                                            ${escapeHtml(e.expenseDate)}
                                        </td>
                                        <td>
                                            <div class="fw-semibold">${safeDesc}</div>
                                            ${payHtml}
                                        </td>
                                        <td>
                                            <span class="badge px-2.5 py-1.5" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); font-weight: 600;">
                                                ${escapeHtml(e.categoryName || '')}
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold text-danger fs-6 text-nowrap">
                                            ₹${escapeHtml(e.amountFormatted)}
                                        </td>
                                        <td class="text-center">
                                            <div class="d-inline-flex gap-1">
                                                <a href="/Expense/Edit/${e.expenseId}" class="btn btn-sm btn-outline-primary" title="Edit Expense">
                                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('Expense', ${e.expenseId}, '${safeDescArg}', this.closest('tr'))" title="Delete Expense">
                                                    <i class="bi bi-trash me-1"></i>Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                `;
                            }).join('');
                        }
                    }

                    const newUrl = query ? `/Expense?search=${encodeURIComponent(query)}` : '/Expense';
                    window.history.replaceState({ path: newUrl }, '', newUrl);
                } catch (err) {
                    console.error('Expense search API error:', err);
                    showToast('Error searching expenses: ' + err.message, 'error');
                }
            }

            if (searchForm) {
                searchForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    searchExpenses(searchInput ? searchInput.value.trim() : '');
                });
            }

            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    if (searchInput) searchInput.value = '';
                    searchExpenses('');
                });
            }
        })();
    </script>
}
