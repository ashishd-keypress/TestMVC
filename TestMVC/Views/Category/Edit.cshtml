@model TestMVC.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Edit Category
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit" asp-route-id="@Model.CategoryId" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CategoryId" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div class="mb-3">
                            <label asp-for="CategoryName" class="form-label fw-semibold">
                                Category Name <span class="required-star">*</span>
                            </label>
                            <input asp-for="CategoryName" class="form-control" placeholder="Enter category name" />
                            <span asp-validation-for="CategoryName" class="text-danger small"></span>
                        </div>

                        <!-- Category Image Upload (Add / Update / Replace) -->
                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                Category Image <span class="required-star">*</span>
                            </label>
                            <div class="image-upload-card">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded bg-body border">
                                        <div class="image-preview-wrapper">
                                            <img src="@Model.ImageUrl" alt="Current Category Image" id="currentCatImg" />
                                        </div>
                                        <div>
                                            <span class="badge bg-success image-preview-badge mb-1">Current Image</span>
                                            <p class="text-muted small mb-0">Select a new file below to replace this image.</p>
                                        </div>
                                    </div>
                                }
                                <label class="form-label small fw-semibold text-muted mb-1">
                                    @(!string.IsNullOrEmpty(Model.ImageUrl) ? "Replace Image:" : "Upload Image:")
                                </label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="catEditImageInput" onchange="previewSelectedImage(this, 'catEditImagePreviewContainer', 'catEditImagePreviewImg')" />
                                <div class="form-text small text-muted mt-1">
                                    Allowed formats: JPG, JPEG, PNG, WEBP, GIF, SVG (Max 5MB)
                                </div>
                                <div id="catEditImagePreviewContainer" class="mt-3" style="display: none;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="image-preview-wrapper">
                                            <img id="catEditImagePreviewImg" src="" alt="New Category Preview" />
                                        </div>
                                        <div>
                                            <span class="badge bg-primary image-preview-badge mb-1">New Image Preview</span>
                                            <p class="text-muted small mb-0">This new image will replace the current one upon saving.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <!-- Status Switch -->
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="categoryEditIsActiveSwitch" />
                                <label class="form-check-label fw-semibold" for="categoryEditIsActiveSwitch">
                                    Active Status <span class="text-muted small fw-normal">(ON = Active, OFF = Inactive)</span>
                                </label>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                &larr; Back to Categories
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Update Category
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
