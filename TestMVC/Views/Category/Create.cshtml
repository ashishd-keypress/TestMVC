@model TestMVC.Models.Category
@{
    ViewData["Title"] = "Add Category";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-tag text-primary me-2"></i>Add New Category
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="CategoryName" class="form-label fw-semibold">
                                Category Name <span class="required-star">*</span>
                            </label>
                            <input asp-for="CategoryName" class="form-control" placeholder="e.g. Footwear, Electronics, Clothing" />
                            <span asp-validation-for="CategoryName" class="text-danger small"></span>
                        </div>

                        <!-- Status Switch -->
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="categoryIsActiveSwitch" checked />
                                <label class="form-check-label fw-semibold" for="categoryIsActiveSwitch">
                                    Active Status <span class="text-muted small fw-normal">(ON = Active, OFF = Inactive)</span>
                                </label>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                &larr; Back to Categories
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Category
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
