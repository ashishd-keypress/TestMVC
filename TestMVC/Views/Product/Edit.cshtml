@model TestMVC.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Edit Product / Mobile Model
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <!-- Product Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Product / Model Name <span class="required-star">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Product Image Upload (Add / Update / Replace) -->
                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                Product Image <span class="required-star">*</span>
                            </label>
                            <div class="image-upload-card">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <div class="d-flex align-items-center gap-3 mb-3 p-3 rounded image-current-box">
                                        <div class="image-preview-wrapper">
                                            <img src="@Model.ImageUrl" alt="Current Product Image" id="currentProductImg" />
                                        </div>
                                        <div>
                                            <span class="badge bg-success image-preview-badge mb-1">Current Image</span>
                                            <p class="text-muted small mb-0">Select a new photo below to replace this product image.</p>
                                        </div>
                                    </div>
                                }
                                <label class="form-label small fw-semibold text-muted mb-1">
                                    @(!string.IsNullOrEmpty(Model.ImageUrl) ? "Replace Product Image:" : "Upload Product Image:")
                                </label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="productEditImageInput" onchange="previewSelectedImage(this, 'productEditImagePreviewContainer', 'productEditImagePreviewImg')" />
                                <div class="form-text small text-muted mt-1">
                                    Allowed formats: JPG, JPEG, PNG, WEBP, GIF, SVG (Max 5MB)
                                </div>
                                <div id="productEditImagePreviewContainer" class="mt-3" style="display: none;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="image-preview-wrapper">
                                            <img id="productEditImagePreviewImg" src="" alt="New Product Preview" />
                                        </div>
                                        <div>
                                            <span class="badge bg-primary image-preview-badge mb-1">New Image Preview</span>
                                            <p class="text-muted small mb-0">This new photo will replace the current image upon saving.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <!-- Brand & Category -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="BrandId" class="form-label fw-semibold">Brand <span class="required-star">*</span></label>
                                <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                                    <option value="">-- Select Brand --</option>
                                </select>
                                <span asp-validation-for="BrandId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="required-star">*</span></label>
                                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Mobile Variant: RAM, Storage, Color -->
                        <div class="p-3 rounded variant-spec-box mb-3">
                            <h6 class="fw-bold mb-2 text-primary small text-uppercase">
                                <i class="bi bi-cpu me-1"></i> Mobile Specifications &amp; Variant
                            </h6>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="RAM" class="form-label small fw-semibold">RAM</label>
                                    <input asp-for="RAM" class="form-control" placeholder="e.g. 8 GB" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Storage" class="form-label small fw-semibold">Storage</label>
                                    <input asp-for="Storage" class="form-control" placeholder="e.g. 128 GB" />
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Color" class="form-label small fw-semibold">Color</label>
                                    <input asp-for="Color" class="form-control" placeholder="e.g. Pastel Lime" />
                                </div>
                            </div>
                        </div>

                        <!-- Pricing & Warranty -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Price" class="form-label fw-semibold">Selling Price <span class="required-star">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text currency-prefix">₹</span>
                                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MRP" class="form-label fw-semibold">MRP (₹)</label>
                                <div class="input-group">
                                    <span class="input-group-text currency-prefix">₹</span>
                                    <input asp-for="MRP" type="number" step="0.01" min="0" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="WarrantyMonths" class="form-label fw-semibold">Warranty (Months)</label>
                                <input asp-for="WarrantyMonths" type="number" min="0" class="form-control" />
                            </div>
                        </div>

                        <!-- Barcode & SKU -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="SKU" class="form-label small fw-semibold">SKU Code</label>
                                <input asp-for="SKU" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Barcode" class="form-label small fw-semibold">Barcode</label>
                                <input asp-for="Barcode" class="form-control" />
                            </div>
                        </div>

                        <!-- Switches: Track IMEI & Active Status -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-check form-switch form-switch-card p-3 rounded">
                                    <input asp-for="TrackIMEI" class="form-check-input ms-0 me-2" type="checkbox" id="productEditTrackImeiSwitch" />
                                    <label class="form-check-label fw-semibold" for="productEditTrackImeiSwitch">
                                        Track Device IMEIs <span class="text-muted small d-block">Enable for Smartphones / Tablets</span>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch form-switch-card p-3 rounded">
                                    <input asp-for="IsActive" class="form-check-input ms-0 me-2" type="checkbox" id="productEditIsActiveSwitch" />
                                    <label class="form-check-label fw-semibold" for="productEditIsActiveSwitch">
                                        Active in Catalog <span class="text-muted small d-block">Visible in POS & store</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                &larr; Back to Products
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Update Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
