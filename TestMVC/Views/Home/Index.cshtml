@model TestMVC.Models.DashboardViewModel
@{
    ViewData["Title"] = "DashBoard";
}

<div class="dashboard-wrapper">
    <!-- Looping Autoplay Background Video -->
    <video autoplay muted loop playsinline id="dashboardVideoBg" class="dashboard-video-bg">
        <source src="~/videos/dashboard-bg.mp4" type="video/mp4" />
        <source src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" type="video/mp4" />
    </video>

    <!-- Glassmorphic Overlay -->
    <div class="dashboard-overlay"></div>

    <!-- Dashboard Content -->
    <div class="dashboard-content text-white">
        <div class="mb-4">
            <span class="badge bg-primary px-3 py-2 text-white mb-2 fs-7 text-uppercase" style="letter-spacing: 0.08em;">
                Control Center
            </span>
            <h1 class="display-5 fw-bold mb-2 text-white">Store Dashboard</h1>
            <p class="text-white-50 fs-6 mb-0">
                Real-time inventory statistics, brands, categories, and quick actions.
            </p>
        </div>

        <!-- KPI Metrics Grid -->
        <div class="row g-4 mb-4">
            <!-- Active Products Card -->
            <div class="col-md-4">
                <a asp-controller="Product" asp-action="Index" class="kpi-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="kpi-icon kpi-icon-product">
                            📦
                        </div>
                        <span class="badge bg-success text-white">Active</span>
                    </div>
                    <div class="kpi-label mb-1">Active Products</div>
                    <div class="kpi-number counter" data-target="@Model.TotalProducts">@Model.TotalProducts</div>
                    <div class="mt-3 text-primary small fw-semibold">
                        View all products &rarr;
                    </div>
                </a>
            </div>

            <!-- Active Brands Card -->
            <div class="col-md-4">
                <a asp-controller="Brand" asp-action="Index" class="kpi-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="kpi-icon kpi-icon-brand">
                            🏷️
                        </div>
                        <span class="badge bg-success text-white">Active</span>
                    </div>
                    <div class="kpi-label mb-1">Active Brands</div>
                    <div class="kpi-number counter" data-target="@Model.TotalBrands">@Model.TotalBrands</div>
                    <div class="mt-3 text-primary small fw-semibold">
                        Manage brands &rarr;
                    </div>
                </a>
            </div>

            <!-- Active Categories Card -->
            <div class="col-md-4">
                <a asp-controller="Category" asp-action="Index" class="kpi-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="kpi-icon kpi-icon-category">
                            📁
                        </div>
                        <span class="badge bg-success text-white">Active</span>
                    </div>
                    <div class="kpi-label mb-1">Active Categories</div>
                    <div class="kpi-number counter" data-target="@Model.TotalCategories">@Model.TotalCategories</div>
                    <div class="mt-3 text-primary small fw-semibold">
                        Manage categories &rarr;
                    </div>
                </a>
            </div>
        </div>

        <!-- Quick Action Shortcuts -->
        <div class="d-flex flex-wrap gap-2 pt-2">
            <a asp-controller="Product" asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> + Add Product
            </a>
            <a asp-controller="Category" asp-action="Create" class="btn btn-light px-3 shadow-sm">
                <i class="bi bi-tag me-1"></i> + Add Category
            </a>
            <a asp-controller="Brand" asp-action="Create" class="btn btn-light px-3 shadow-sm">
                <i class="bi bi-briefcase me-1"></i> + Add Brand
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light px-3">
                <i class="bi bi-search me-1"></i> Search Products
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Smooth Counter Animation for KPI stats
        document.addEventListener('DOMContentLoaded', () => {
            const counters = document.querySelectorAll('.counter');
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target') || 0;
                let count = 0;
                const speed = 25;
                const increment = Math.max(1, Math.ceil(target / speed));

                const updateCount = () => {
                    count += increment;
                    if (count < target) {
                        counter.innerText = count;
                        setTimeout(updateCount, 20);
                    } else {
                        counter.innerText = target;
                    }
                };

                if (target > 0) {
                    updateCount();
                }
            });

            // Ensure video autoplays smoothly
            const video = document.getElementById('dashboardVideoBg');
            if (video) {
                video.play().catch(() => {
                    // Browser autoplay policy handler
                    video.muted = true;
                    video.play();
                });
            }
        });
    </script>
}
