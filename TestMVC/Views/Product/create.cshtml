@model TestMVC.Models.Product
@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="card-title mb-0 text-dark fw-bold">
                        <i class="bi bi-box-seam text-primary me-2"></i>Add New Product
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Product Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">
                                Product Name <span class="required-star">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" placeholder="Enter product name (e.g. Laptop X1)" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Brand Dropdown -->
                        <div class="mb-3">
                            <label asp-for="BrandId" class="form-label fw-semibold">
                                Brand <span class="required-star">*</span>
                            </label>
                            <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                                <option value="">-- Select Brand --</option>
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger small"></span>
                        </div>

                        <!-- Category Dropdown -->
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold">
                                Category <span class="required-star">*</span>
                            </label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <!-- Price -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold">
                                    Price <span class="required-star">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted">₹</span>
                                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <!-- Size -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Size" class="form-label fw-semibold">
                                    Size <span class="required-star">*</span>
                                </label>
                                <input asp-for="Size" class="form-control" placeholder="e.g. UK-9, Medium, 15-inch" />
                                <span asp-validation-for="Size" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Status Switch -->
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="productIsActiveSwitch" checked />
                                <label class="form-check-label fw-semibold" for="productIsActiveSwitch">
                                    Active Status <span class="text-muted small fw-normal">(ON = Active, OFF = Inactive)</span>
                                </label>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                &larr; Back to Products
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Product
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}