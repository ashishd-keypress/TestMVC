@model TestMVC.Models.Purchase
@{
    ViewData["Title"] = "New Purchase Inward";
    var productsList = ViewBag.ProductsList as List<TestMVC.Models.ReqRes.GetProductRes> ?? new List<TestMVC.Models.ReqRes.GetProductRes>();
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.025em;">Stock Inward & Purchase Entry</h2>
            <p class="text-muted small mb-0">Record newly purchased mobile stock, accessories, and register device IMEI numbers.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Purchases
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 py-2 px-3 mb-3" role="alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div class="flex-grow-1">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div class="small fw-medium m-0">@error.ErrorMessage</div>
                }
            </div>
            <button type="button" class="btn-close position-static p-1 ms-auto" data-bs-dismiss="alert" aria-label="Close" style="font-size: 0.72rem;"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="purchaseForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="itemsJson" id="purchaseItemsJsonInput" />

        <div class="row g-4">
            <!-- Left: Purchase Details & Items -->
            <div class="col-lg-8">
                <!-- Supplier & Bill Metadata -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header border-bottom py-3">
                        <h6 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-truck text-primary"></i> Supplier & Bill Details
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label asp-for="SupplierId" class="form-label small fw-semibold">Supplier <span class="text-danger">*</span></label>
                                <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                                    <option value="">-- Select Supplier --</option>
                                </select>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="InvoiceNumber" class="form-label small fw-semibold">Distributor Bill / Inv No. <span class="text-danger">*</span></label>
                                <input asp-for="InvoiceNumber" class="form-control" placeholder="e.g. BILL-9921" />
                                <span asp-validation-for="InvoiceNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="PurchaseDate" class="form-label small fw-semibold">Purchase Date <span class="text-danger">*</span></label>
                                <input asp-for="PurchaseDate" type="date" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add Items Form -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header border-bottom py-3 bg-light">
                        <h6 class="card-title mb-0 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam text-primary"></i> Add Products to Inward Stock
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-3 align-items-start">
                            <div class="col-md-5">
                                <label class="form-label small fw-semibold">Product</label>
                                <select id="purProductSelect" class="form-select" onchange="onPurProductChanged()">
                                    <option value="">-- Choose Product --</option>
                                    @foreach (var p in productsList)
                                    {
                                        <option value="@p.ProductId" 
                                                data-name="@p.Name"
                                                data-cost="@p.Price"
                                                data-track="@(p.TrackIMEI ? "1" : "0")">
                                            @p.Name @(!string.IsNullOrEmpty(p.RAM) ? $"({p.RAM}/{p.Storage})" : "") @(p.TrackIMEI ? "[IMEI Tracked]" : "")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label small fw-semibold">Unit Purchase Cost (₹)</label>
                                <input type="number" id="purUnitCost" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>

                            <div class="col-md-2" id="purQtyWrap">
                                <label class="form-label small fw-semibold">Quantity</label>
                                <input type="number" id="purQty" class="form-control" min="1" value="1" />
                            </div>

                            <div class="col-md-2 pt-4">
                                <button type="button" class="btn btn-primary w-100" onclick="addPurchaseItem()">
                                    <i class="bi bi-plus-lg"></i> Add
                                </button>
                            </div>

                            <!-- IMEI Numbers Box (shown if TrackIMEI is true) -->
                            <div class="col-12" id="imeiInputBox" style="display: none;">
                                <div class="p-3 rounded bg-light border">
                                    <label class="form-label small fw-bold text-primary mb-1">
                                        <i class="bi bi-upc-scan me-1"></i> Enter or Scan Device IMEIs (One per line or comma-separated)
                                    </label>
                                    <textarea id="purIMEIs" rows="3" class="form-control font-monospace" placeholder="e.g.&#10;860123456789012&#10;860123456789013&#10;860123456789014" oninput="updateQtyFromImeis()"></textarea>
                                    <div class="small text-muted mt-1">Quantity is automatically counted from valid IMEI lines entered above.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Inward Items Table -->
                <div class="card shadow-sm border-0">
                    <div class="card-header border-bottom py-3">
                        <h6 class="card-title mb-0 fw-bold">Inward Items List</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;">#</th>
                                        <th>Product Name</th>
                                        <th>IMEI Numbers Tracked</th>
                                        <th style="width: 80px;" class="text-center">Qty</th>
                                        <th style="width: 120px;" class="text-end">Unit Cost</th>
                                        <th style="width: 120px;" class="text-end">Total</th>
                                        <th style="width: 50px;" class="text-center">Del</th>
                                    </tr>
                                </thead>
                                <tbody id="purTableBody">
                                    <tr id="emptyPurRow">
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            <em>No products added to this purchase bill yet.</em>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Totals & Save -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                    <div class="card-header border-bottom py-3 bg-light">
                        <h6 class="card-title mb-0 fw-bold">Bill Totals</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Sub Total</span>
                            <span class="fw-semibold" id="purLblSubTotal">₹0.00</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-muted">Discount (₹)</span>
                            <input type="number" asp-for="Discount" id="purDiscount" step="0.01" min="0" class="form-control form-control-sm text-end" style="width: 120px;" value="0" oninput="calculatePurTotals()" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-muted">Tax / GST (₹)</span>
                            <input type="number" asp-for="TaxAmount" id="purTax" step="0.01" min="0" class="form-control form-control-sm text-end" style="width: 120px;" value="0" oninput="calculatePurTotals()" />
                        </div>

                        <div class="d-flex justify-content-between py-3 border-bottom fs-4 fw-bold">
                            <span>Grand Total</span>
                            <span class="text-primary" id="purLblGrandTotal">₹0.00</span>
                        </div>

                        <input type="hidden" asp-for="SubTotal" id="hiddenPurSubTotal" />
                        <input type="hidden" asp-for="GrandTotal" id="hiddenPurGrandTotal" />

                        <div class="mt-4 mb-3">
                            <label asp-for="PaidAmount" class="form-label small fw-semibold">Paid to Supplier (₹)</label>
                            <input type="number" asp-for="PaidAmount" id="purPaidAmount" step="0.01" min="0" class="form-control fw-bold text-end" value="0" oninput="calculatePurDue()" />
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom mb-3">
                            <span class="text-muted fw-semibold">Balance Due to Supplier</span>
                            <span class="fw-bold text-danger" id="purLblDue">₹0.00</span>
                            <input type="hidden" asp-for="DueAmount" id="hiddenPurDue" value="0" />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label small fw-semibold">Remarks / Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-3 fs-5 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-2"></i> Save Purchase & Inward Stock
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const purchaseItems = [];

        function onPurProductChanged() {
            const sel = document.getElementById('purProductSelect');
            const opt = sel.options[sel.selectedIndex];
            const imeiBox = document.getElementById('imeiInputBox');
            const qtyInput = document.getElementById('purQty');
            const costInput = document.getElementById('purUnitCost');

            if (!opt.value) {
                imeiBox.style.display = 'none';
                return;
            }

            costInput.value = parseFloat(opt.getAttribute('data-cost')) || 0;
            const track = opt.getAttribute('data-track') === '1';

            if (track) {
                imeiBox.style.display = 'block';
                qtyInput.readOnly = true;
                updateQtyFromImeis();
            } else {
                imeiBox.style.display = 'none';
                qtyInput.readOnly = false;
                qtyInput.value = 1;
            }
        }

        function updateQtyFromImeis() {
            const lines = document.getElementById('purIMEIs').value
                .split(/[\r\n,]+/)
                .map(s => s.trim())
                .filter(s => s.length > 0);
            document.getElementById('purQty').value = Math.max(1, lines.length);
        }

        function addPurchaseItem() {
            const sel = document.getElementById('purProductSelect');
            const opt = sel.options[sel.selectedIndex];
            if (!opt || !opt.value) {
                showToast('Please select a product.', 'error');
                return;
            }

            const productId = parseInt(opt.value);
            const productName = opt.getAttribute('data-name');
            const unitCost = parseFloat(document.getElementById('purUnitCost').value) || 0;
            const track = opt.getAttribute('data-track') === '1';
            const imeiText = document.getElementById('purIMEIs').value.trim();
            const qty = parseInt(document.getElementById('purQty').value) || 1;

            if (track && !imeiText) {
                showToast('Please enter or scan at least one IMEI number for this tracked mobile device.', 'error');
                return;
            }

            purchaseItems.push({
                ProductId: productId,
                ProductName: productName,
                TrackIMEI: track,
                UnitCost: unitCost,
                Quantity: qty,
                Discount: 0,
                TaxAmount: 0,
                TotalAmount: unitCost * qty,
                IMEINumbers: imeiText
            });

            renderPurItems();

            // Reset inputs
            document.getElementById('purProductSelect').value = '';
            document.getElementById('purUnitCost').value = '';
            document.getElementById('purIMEIs').value = '';
            document.getElementById('imeiInputBox').style.display = 'none';
        }

        function removePurItem(index) {
            purchaseItems.splice(index, 1);
            renderPurItems();
        }

        function renderPurItems() {
            const tbody = document.getElementById('purTableBody');
            if (purchaseItems.length === 0) {
                tbody.innerHTML = `<tr id="emptyPurRow"><td colspan="7" class="text-center py-4 text-muted"><em>No products added to this purchase bill yet.</em></td></tr>`;
            } else {
                tbody.innerHTML = purchaseItems.map((item, idx) => `
                    <tr>
                        <td class="text-muted small">${idx + 1}</td>
                        <td class="fw-semibold">${item.ProductName}</td>
                        <td>
                            ${item.TrackIMEI ? `<small class="text-muted font-monospace">${item.IMEINumbers ? item.IMEINumbers.replace(/\n/g, ', ') : '-'}</small>` : '<span class="text-muted small">Accessory / Non-IMEI</span>'}
                        </td>
                        <td class="text-center">${item.Quantity}</td>
                        <td class="text-end">₹${item.UnitCost.toFixed(2)}</td>
                        <td class="text-end fw-bold">₹${item.TotalAmount.toFixed(2)}</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removePurItem(${idx})">&times;</button>
                        </td>
                    </tr>
                `).join('');
            }

            calculatePurTotals();
        }

        function calculatePurTotals() {
            const subTotal = purchaseItems.reduce((acc, curr) => acc + curr.TotalAmount, 0);
            const discount = parseFloat(document.getElementById('purDiscount').value) || 0;
            const tax = parseFloat(document.getElementById('purTax').value) || 0;
            const grandTotal = Math.max(0, subTotal - discount + tax);

            document.getElementById('purLblSubTotal').innerText = `₹${subTotal.toFixed(2)}`;
            document.getElementById('purLblGrandTotal').innerText = `₹${grandTotal.toFixed(2)}`;

            document.getElementById('hiddenPurSubTotal').value = subTotal.toFixed(2);
            document.getElementById('hiddenPurGrandTotal').value = grandTotal.toFixed(2);

            const paidInput = document.getElementById('purPaidAmount');
            if (paidInput.value === "0" || paidInput.getAttribute('data-user-edited') !== 'true') {
                paidInput.value = grandTotal.toFixed(2);
            }

            calculatePurDue();
        }

        function calculatePurDue() {
            const grandTotal = parseFloat(document.getElementById('hiddenPurGrandTotal').value) || 0;
            const paidInput = document.getElementById('purPaidAmount');
            paidInput.setAttribute('data-user-edited', 'true');
            const paid = parseFloat(paidInput.value) || 0;
            const due = Math.max(0, grandTotal - paid);

            document.getElementById('purLblDue').innerText = `₹${due.toFixed(2)}`;
            document.getElementById('hiddenPurDue').value = due.toFixed(2);
        }

        document.getElementById('purchaseForm').addEventListener('submit', function (e) {
            if (purchaseItems.length === 0) {
                e.preventDefault();
                showToast('Please add at least one product item to inward.', 'error');
                return false;
            }
            document.getElementById('purchaseItemsJsonInput').value = JSON.stringify(purchaseItems);
        });
    </script>
}
