@model TestMVC.Models.ReqRes.LoginReq
@{
    ViewData["Title"] = "Welcome to Admin Panel";
}

<!-- Floating Theme Switcher on Login Screen -->
<div class="login-theme-switch">
    <button type="button" class="theme-toggle-btn shadow-sm" id="themeToggleBtn" title="Toggle Light / Dark Mode">
        <span class="theme-sun-icon d-flex align-items-center gap-1">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <span class="small fw-semibold">Light</span>
        </span>
        <span class="theme-moon-icon d-flex align-items-center gap-1">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <span class="small fw-semibold">Dark</span>
        </span>
    </button>
</div>

<div class="login-wrapper">
    <div class="login-card shadow-sm">
        <div class="login-header">
            <h2 class="login-title">Welcome to Admin Panel</h2>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 rounded-3 small border-0" style="background-color: #FEE2E2; color: #991B1B;">
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span>âš ï¸</span>
                        <span>@error.ErrorMessage</span>
                    </div>
                }
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success py-2 px-3 mb-3 rounded-3 small border-0" style="background-color: #DCFCE7; color: #166534;">
                @TempData["Success"]
            </div>
        }

        <form asp-action="Login" method="post" id="loginForm" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input type="hidden" asp-for="ExpectedValidationCode" id="expectedValidationCode" value="@(Model?.ExpectedValidationCode ?? ViewBag.ValidationCode)" />

            <!-- 1. Username Field -->
            <div class="custom-field-wrap mb-3">
                <input asp-for="Username"
                       class="custom-field-input"
                       placeholder="Username"
                       autocomplete="username"
                       autofocus />
            </div>
            <span asp-validation-for="Username" class="text-danger small d-block mb-2" style="font-size: 0.8rem;"></span>

            <!-- 2. Password Field with Eye Toggle Icon -->
            <div class="custom-field-wrap mb-3">
                <input asp-for="Password"
                       type="password"
                       id="loginPasswordInput"
                       class="custom-field-input"
                       placeholder="Password"
                       autocomplete="current-password" />
                <button type="button"
                        class="field-icon-btn"
                        id="btnTogglePassword"
                        onclick="togglePasswordVisibility('loginPasswordInput', this)"
                        title="Show/Hide Password"
                        aria-label="Toggle Password Visibility">
                    <!-- Slashed Eye SVG Icon (matching screenshot) -->
                    <svg id="eyeOffIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                    <!-- Open Eye SVG Icon (hidden by default) -->
                    <svg id="eyeOnIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small d-block mb-2" style="font-size: 0.8rem;"></span>

            <!-- 3. Validation Code Field with Dynamic Captcha Code & Refresh Button -->
            <div class="custom-field-wrap mb-4">
                <input asp-for="ValidationCode"
                       id="validationCodeInput"
                       class="custom-field-input"
                       placeholder="Validation Code"
                       maxlength="4"
                       autocomplete="off" />
                <div class="captcha-addon">
                    <span id="captchaCodeText" class="captcha-digits">@(Model?.ExpectedValidationCode ?? ViewBag.ValidationCode)</span>
                    <button type="button"
                            class="field-icon-btn btn-refresh"
                            id="btnRefreshCaptcha"
                            onclick="refreshCaptchaCode()"
                            title="Refresh Validation Code"
                            aria-label="Refresh Validation Code">
                        <!-- Reload Arrows SVG Icon (matching screenshot) -->
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="23 4 23 10 17 10"></polyline>
                            <polyline points="1 20 1 14 7 14"></polyline>
                            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                        </svg>
                    </button>
                </div>
            </div>
            <span asp-validation-for="ValidationCode" class="text-danger small d-block mb-2" style="font-size: 0.8rem;"></span>

            <!-- 4. Login Button (Yellow/Amber Rounded Button) -->
            <div class="mb-2">
                <button type="submit" class="btn-custom-login" id="btnLoginSubmit">
                    Login
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    /* Full Page Background */
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background-color: var(--bg-main);
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        position: relative;
        transition: background-color 0.25s ease;
    }

    .login-theme-switch {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 100;
    }

    /* Container Card */
    .login-card {
        background: var(--surface-card);
        width: 100%;
        max-width: 480px;
        border-radius: 20px;
        padding: 44px 38px;
        box-shadow: var(--card-shadow);
        border: 1px solid var(--border-color);
        transition: background-color 0.25s ease, border-color 0.25s ease;
    }

    /* Title */
    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-title {
        font-size: 26px;
        font-weight: 800;
        color: var(--text-main);
        margin: 0;
        letter-spacing: -0.4px;
    }

    /* Soft Rounded Inputs (Matching Screenshot in Light Mode, adapting cleanly in Dark Mode) */
    .custom-field-wrap {
        background-color: #DDE2E8;
        border-radius: 12px;
        height: 52px;
        display: flex;
        align-items: center;
        padding: 0 16px;
        transition: all 0.2s ease;
        border: 1.5px solid transparent;
    }

    [data-theme="dark"] .custom-field-wrap {
        background-color: #1e293b;
        border-color: rgba(255, 255, 255, 0.1);
    }

    .custom-field-wrap:focus-within {
        background-color: #D6DCE3;
        border-color: #CBD5E1;
        box-shadow: 0 0 0 3px rgba(245, 176, 39, 0.25);
    }

    [data-theme="dark"] .custom-field-wrap:focus-within {
        background-color: #273549;
        border-color: #f5b027;
        box-shadow: 0 0 0 3px rgba(245, 176, 39, 0.25);
    }

    .custom-field-input {
        flex: 1;
        height: 100%;
        background: transparent;
        border: none;
        outline: none;
        font-size: 15px;
        font-weight: 500;
        color: #1F2937;
    }

    [data-theme="dark"] .custom-field-input {
        color: #f8fafc;
    }

    .custom-field-input::placeholder {
        color: #64748B;
        opacity: 1;
        font-weight: 500;
    }

    [data-theme="dark"] .custom-field-input::placeholder {
        color: #94a3b8;
    }

    /* Field Accessory Buttons (Eye & Refresh) */
    .field-icon-btn {
        background: none;
        border: none;
        padding: 4px;
        color: #1F2937;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.85;
        transition: opacity 0.2s, transform 0.2s;
    }

    [data-theme="dark"] .field-icon-btn {
        color: #f8fafc;
    }

    .field-icon-btn:hover {
        opacity: 1;
    }

    .field-icon-btn:active {
        transform: scale(0.92);
    }

    .captcha-addon {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: 8px;
    }

    .captcha-digits {
        font-family: 'Courier New', Courier, monospace;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 2.5px;
        color: #1F2937;
        user-select: none;
    }

    [data-theme="dark"] .captcha-digits {
        color: #f8fafc;
    }

    /* Golden/Amber Action Button */
    .btn-custom-login {
        width: 100%;
        height: 52px;
        background-color: #F5B027;
        color: #1F2937;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: 0.3px;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
        box-shadow: 0 4px 12px rgba(245, 176, 39, 0.3);
    }

    .btn-custom-login:hover {
        background-color: #EFA61B;
        box-shadow: 0 6px 16px rgba(245, 176, 39, 0.4);
        transform: translateY(-1px);
    }

    .btn-custom-login:active {
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(245, 176, 39, 0.3);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Refresh Captcha Code
        function refreshCaptchaCode() {
            const btn = document.getElementById('btnRefreshCaptcha');
            if (btn) btn.style.transform = 'rotate(180deg)';

            fetch('/api/Auth/generate-captcha', {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                if (data && data.code) {
                    const textSpan = document.getElementById('captchaCodeText');
                    const hiddenExpected = document.getElementById('expectedValidationCode');
                    if (textSpan) textSpan.innerText = data.code;
                    if (hiddenExpected) hiddenExpected.value = data.code;
                }
            })
            .catch(err => {
                const random4 = Math.floor(1000 + Math.random() * 9000).toString();
                const textSpan = document.getElementById('captchaCodeText');
                const hiddenExpected = document.getElementById('expectedValidationCode');
                if (textSpan) textSpan.innerText = random4;
                if (hiddenExpected) hiddenExpected.value = random4;
            })
            .finally(() => {
                setTimeout(() => {
                    if (btn) btn.style.transform = 'none';
                }, 300);
            });
        }

        // Toggle Password Visibility
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const eyeOff = document.getElementById('eyeOffIcon');
            const eyeOn = document.getElementById('eyeOnIcon');
            if (!input) return;

            if (input.type === 'password') {
                input.type = 'text';
                if (eyeOff) eyeOff.style.display = 'none';
                if (eyeOn) eyeOn.style.display = 'inline';
            } else {
                input.type = 'password';
                if (eyeOff) eyeOff.style.display = 'inline';
                if (eyeOn) eyeOn.style.display = 'none';
            }
        }
    </script>
}