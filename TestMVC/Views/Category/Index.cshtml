@model List<TestMVC.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge px-3 py-1 mb-2" style="background: var(--category-soft); color: var(--category-color); border: 1px solid var(--category-border); font-size: 0.72rem; font-weight: 700; border-radius: 9999px; letter-spacing: 0.05em;">ðŸ“ CATEGORY DIRECTORY</span>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.025em;">Categories</h2>
            <p class="text-muted small mb-0">Organize and structure products across departments.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Add Category</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 80px;" class="text-center">ID</th>
                    <th scope="col">Category Name</th>
                    <th scope="col" class="text-center" style="width: 110px;">Status</th>
                    <th scope="col" style="width: 200px;">Created Date</th>
                    <th scope="col" style="width: 170px;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <em>No categories found.</em>
                        </td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold text-center">@c.CategoryId</td>
                        <td>
                            <span class="badge-category">@c.CategoryName</span>
                        </td>
                        <td class="text-center">
                            @if (c.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-status-on px-2 py-1" onclick="toggleStatus('Category', @c.CategoryId, this)" title="Click to turn OFF (Inactive)">
                                    <i class="bi bi-toggle-on me-1"></i> ON
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-status-off px-2 py-1" onclick="toggleStatus('Category', @c.CategoryId, this)" title="Click to turn ON (Active)">
                                    <i class="bi bi-toggle-off me-1"></i> OFF
                                </button>
                            }
                        </td>
                        <td>
                            @(c.CreatedDate.HasValue ? c.CreatedDate.Value.ToString("yyyy-MM-dd HH:mm") : "-")
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@c.CategoryId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('Category', @c.CategoryId, '@c.CategoryName.Replace("'", "\\'") ', this.closest('tr'))" title="Delete">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
