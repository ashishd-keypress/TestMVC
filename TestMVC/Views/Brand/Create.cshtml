@model TestMVC.Models.Brand
@{
    ViewData["Title"] = "Add Brand";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-briefcase text-primary me-2"></i>Add New Brand
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="BrandName" class="form-label fw-semibold">
                                Brand Name <span class="required-star">*</span>
                            </label>
                            <input asp-for="BrandName" class="form-control" placeholder="e.g. Nike, Adidas, Lenovo, Apple" />
                            <span asp-validation-for="BrandName" class="text-danger small"></span>
                        </div>

                        <!-- Brand Image Upload (Mandatory) -->
                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                Brand Image <span class="required-star">*</span>
                            </label>
                            <div class="image-upload-card">
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" id="brandImageInput" onchange="previewSelectedImage(this, 'brandImagePreviewContainer', 'brandImagePreviewImg')" />
                                <div class="form-text small text-muted mt-1">
                                    Allowed formats: JPG, JPEG, PNG, WEBP, GIF, SVG (Max 5MB)
                                </div>
                                <div id="brandImagePreviewContainer" class="mt-3" style="display: none;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="image-preview-wrapper">
                                            <img id="brandImagePreviewImg" src="" alt="Brand Preview" />
                                        </div>
                                        <div>
                                            <span class="badge bg-primary image-preview-badge mb-1">Image Preview</span>
                                            <p class="text-muted small mb-0">Selected image ready to upload.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="ImageFile" class="text-danger small"></span>
                        </div>

                        <!-- Status Switch -->
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="brandIsActiveSwitch" checked />
                                <label class="form-check-label fw-semibold" for="brandIsActiveSwitch">
                                    Active Status <span class="text-muted small fw-normal">(ON = Active, OFF = Inactive)</span>
                                </label>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                &larr; Back to Brands
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Brand
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
