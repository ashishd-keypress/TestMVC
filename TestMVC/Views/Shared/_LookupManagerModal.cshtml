@model TestMVC.Models.LookupModalConfig

<div class="modal fade" id="@Model.ModalId" tabindex="-1" aria-labelledby="@(Model.ModalId)Label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg" style="background-color: var(--surface-card); color: var(--text-main); border: 1px solid var(--border-color); border-radius: 16px;">
            <div class="modal-header border-bottom py-3 px-4" style="border-color: var(--border-color) !important;">
                <div>
                    <h5 class="modal-title fw-bold mb-0 d-flex align-items-center gap-2" id="@(Model.ModalId)Label">
                        <i class="bi @Model.IconClass text-primary"></i>
                        <span>@Model.Title</span>
                    </h5>
                    <small class="text-muted">@Model.Subtitle</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="@Model.AlertBoxId" class="d-none mb-3" role="alert"></div>

                <form id="@Model.InsertFormId" class="mb-4" autocomplete="off" novalidate>
                    <label for="@Model.InsertInputId" class="form-label fw-semibold small text-uppercase text-muted mb-2">
                        @Model.InsertLabel
                    </label>
                    <div class="input-group">
                        <input type="text"
                               id="@Model.InsertInputId"
                               class="form-control"
                               maxlength="100"
                               placeholder="@Model.InsertPlaceholder" />
                        <button type="submit" class="btn btn-primary px-3 fw-semibold" id="@Model.InsertButtonId">
                            <i class="bi bi-plus-circle me-1"></i> Insert
                        </button>
                    </div>
                </form>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-semibold text-uppercase text-muted">@Model.ListHeading</span>
                    <span class="small text-muted" id="@Model.CountLabelId">0 items</span>
                </div>

                <div class="table-responsive rounded" style="max-height: 360px; overflow-y: auto;">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 70px;" class="text-center">Sr. No.</th>
                                <th>@Model.ColumnHeading</th>
                                <th style="width: 210px;" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="@Model.TableBodyId">
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    Click <strong>@Model.OpenTriggerLabel</strong> to load list.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top py-2.5 px-4" style="border-color: var(--border-color) !important;">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
