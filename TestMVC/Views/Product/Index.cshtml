@model List<TestMVC.Models.Product>
@{
    ViewData["Title"] = "Products";
    int pageNo = ViewBag.PageNo;
    string? search = ViewBag.Search;
}

<h2>Products</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search product..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
    <a asp-action="Create" class="btn btn-success">Add Product</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="4" class="text-center">No products found.</td></tr>
        }
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductId</td>
                <td>@p.ProductName</td>
                <td>@p.Price.ToString("N2")</td>
                <td>@p.Quantity</td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex gap-2">
    @if (pageNo > 1)
    {
        <a asp-action="Index" asp-route-search="@search" asp-route-pageNo="@(pageNo - 1)" class="btn btn-outline-secondary">Previous</a>
    }
    <span class="align-self-center">Page @pageNo</span>
    @if ((bool)ViewBag.HasNext)
    {
        <a asp-action="Index" asp-route-search="@search" asp-route-pageNo="@(pageNo + 1)" class="btn btn-outline-secondary">Next</a>
    }
</div>