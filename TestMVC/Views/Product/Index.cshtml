@model List<TestMVC.Models.Product>
@{
    ViewData["Title"] = "Products";
    int pageNo = ViewBag.PageNo ?? 1;
    string? search = ViewBag.Search;
    bool hasNext = ViewBag.HasNext != null && (bool)ViewBag.HasNext;
}

<!-- Hidden AntiForgeryToken for dynamic delete actions -->
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge px-3 py-1 mb-2" style="background: var(--primary-soft); color: var(--primary-color); border: 1px solid var(--primary-border); font-size: 0.72rem; font-weight: 700; border-radius: 9999px; letter-spacing: 0.05em;">ðŸ“¦ PRODUCT INVENTORY</span>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.025em;">Products</h2>
            <p class="text-muted small mb-0">Complete inventory directory, pricing, and live status.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Add Product</span>
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="searchForm" method="get" class="row g-2 align-items-center" onsubmit="event.preventDefault(); triggerSearch(1);">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text text-muted">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        </span>
                        <input type="text"
                               id="searchInput"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Type to search (e.g. Laptop, Dell, Electronics)..."
                               autocomplete="off" />
                        <span class="input-group-text" id="searchSpinner" style="display: none;">
                            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                        </span>
                        <button type="button"
                                id="btnClearSearch"
                                class="btn btn-outline-secondary"
                                style="@(string.IsNullOrEmpty(search) ? "display:none;" : "")"
                                title="Clear Search">
                            ✕
                        </button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-primary" onclick="triggerSearch(1)">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 60px;">ID</th>
                    <th scope="col">Product Name</th>
                    <th scope="col">Brand</th>
                    <th scope="col">Category</th>
                    <th scope="col" class="text-end">Price</th>
                    <th scope="col">Size</th>
                    <th scope="col" class="text-center" style="width: 100px;">Status</th>
                    <th scope="col">Created Date</th>
                    <th scope="col" style="width: 170px;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                @if (Model.Count == 0)
                {
                    <tr id="noRecordsRow">
                        <td colspan="9" class="text-center py-4 text-muted">
                            <em>No products found.</em>
                        </td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold text-center">@p.ProductId</td>
                        <td>@p.Name</td>
                        <td>@(!string.IsNullOrEmpty(p.Brand) ? Html.Raw("<span class=\"badge-brand\">" + p.Brand + "</span>") : Html.Raw("-"))</td>
                        <td>
                            @if (!string.IsNullOrEmpty(p.Category))
                            {
                                <span class="badge-category">@p.Category</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="text-end fw-semibold"><span class="badge-price">₹@p.Price.ToString("N2")</span></td>
                        <td>@(string.IsNullOrEmpty(p.Size) ? "-" : p.Size)</td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-status-on px-2 py-1" onclick="toggleStatus('Product', @p.ProductId, this)" title="Click to turn OFF (Inactive)">
                                    <i class="bi bi-toggle-on me-1"></i> ON
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-status-off px-2 py-1" onclick="toggleStatus('Product', @p.ProductId, this)" title="Click to turn ON (Active)">
                                    <i class="bi bi-toggle-off me-1"></i> OFF
                                </button>
                            }
                        </td>
                        <td>
                            @(p.CreatedDate.HasValue ? p.CreatedDate.Value.ToString("yyyy-MM-dd HH:mm") : "-")
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('Product', @p.ProductId, '@p.Name.Replace("'", "\\'")', this.closest('tr'))" title="Delete">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="paginationContainer" class="d-flex justify-content-between align-items-center mt-3">
        <div id="prevPageBtn">
            @if (pageNo > 1)
            {
                <button type="button" onclick="triggerSearch(@(pageNo - 1))" class="btn btn-outline-primary btn-sm">
                    &laquo; Previous
                </button>
            }
        </div>
        <span id="pageIndicator" class="badge bg-secondary p-2">Page @pageNo</span>
        <div id="nextPageBtn">
            @if (hasNext)
            {
                <button type="button" onclick="triggerSearch(@(pageNo + 1))" class="btn btn-outline-primary btn-sm">
                    Next &raquo;
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let searchTimeout = null;
        let currentPage = @pageNo;

        const searchInput = document.getElementById('searchInput');
        const searchSpinner = document.getElementById('searchSpinner');
        const btnClearSearch = document.getElementById('btnClearSearch');
        const tableBody = document.getElementById('productTableBody');
        const paginationContainer = document.getElementById('paginationContainer');
        const prevPageBtn = document.getElementById('prevPageBtn');
        const nextPageBtn = document.getElementById('nextPageBtn');
        const pageIndicator = document.getElementById('pageIndicator');

        // Real-time live search on user typing
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                const query = this.value.trim();
                if (btnClearSearch) btnClearSearch.style.display = query.length > 0 ? 'inline-block' : 'none';

                if (searchSpinner) searchSpinner.style.display = 'inline-block';

                if (searchTimeout) {
                    clearTimeout(searchTimeout);
                }

                searchTimeout = setTimeout(() => {
                    triggerSearch(1);
                }, 300);
            });
        }

        // Clear button handler
        if (btnClearSearch) {
            btnClearSearch.addEventListener('click', function () {
                if (searchInput) {
                    searchInput.value = '';
                    btnClearSearch.style.display = 'none';
                    searchInput.focus();
                }
                triggerSearch(1);
            });
        }

        // Fetch products matching the search query via AJAX API
        function triggerSearch(pageNo) {
            currentPage = pageNo || 1;
            const query = searchInput ? searchInput.value.trim() : '';
            if (searchSpinner) searchSpinner.style.display = 'inline-block';

            const url = `/api/Product/search?search=${encodeURIComponent(query)}&pageNo=${currentPage}`;

            fetch(url, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(result => {
                    if (searchSpinner) searchSpinner.style.display = 'none';
                    if (result.success) {
                        renderProductTable(result.data, query);
                        renderPagination(result.pageNo, result.hasNext);
                        
                        const newUrl = query ? `/Product?search=${encodeURIComponent(query)}&pageNo=${currentPage}` : `/Product?pageNo=${currentPage}`;
                        window.history.replaceState({ path: newUrl }, '', newUrl);
                    }
                })
                .catch(error => {
                    if (searchSpinner) searchSpinner.style.display = 'none';
                    console.error('Error fetching search results:', error);
                });
        }

        // Render table rows dynamically
        function renderProductTable(products, query) {
            if (!tableBody) return;

            if (!products || products.length === 0) {
                const message = query ? `No products found matching "${escapeHtml(query)}".` : 'No products found.';
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <em>${message}</em>
                        </td>
                    </tr>
                `;
                return;
            }

            let html = '';
            products.forEach(p => {
                const brand = p.brand ? `<span class="badge-brand">${escapeHtml(p.brand)}</span>` : '-';
                const categoryBadge = p.category
                    ? `<span class="badge-category">${escapeHtml(p.category)}</span>`
                    : '<span>-</span>';
                const size = p.size ? escapeHtml(p.size) : '-';
                const formattedPrice = Number(p.price).toLocaleString('en-IN', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                const date = p.createdDate || '-';
                const name = escapeHtml(p.name);
                const safeNameForConfirm = name.replace(/'/g, "\\'");

                const statusBtn = p.isActive
                    ? `<button type="button" class="btn btn-sm btn-status-on px-2 py-1" onclick="toggleStatus('Product', ${p.productId}, this)" title="Click to turn OFF (Inactive)">
                        <i class="bi bi-toggle-on me-1"></i> ON
                       </button>`
                    : `<button type="button" class="btn btn-sm btn-status-off px-2 py-1" onclick="toggleStatus('Product', ${p.productId}, this)" title="Click to turn ON (Active)">
                        <i class="bi bi-toggle-off me-1"></i> OFF
                       </button>`;

                html += `
                    <tr>
                        <td class="fw-bold text-center">${p.productId}</td>
                        <td>${name}</td>
                        <td>${brand}</td>
                        <td>${categoryBadge}</td>
                        <td class="text-end fw-semibold"><span class="badge-price">₹${formattedPrice}</span></td>
                        <td>${size}</td>
                        <td class="text-center">${statusBtn}</td>
                        <td>${date}</td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a href="/Product/Edit/${p.productId}" class="btn btn-sm btn-outline-primary" title="Edit">
                                    Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('Product', ${p.productId}, '${safeNameForConfirm}', this.closest('tr'))" title="Delete">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            tableBody.innerHTML = html;
        }

        // Render pagination controls dynamically
        function renderPagination(pageNo, hasNext) {
            pageIndicator.innerText = `Page ${pageNo}`;

            if (pageNo > 1) {
                prevPageBtn.innerHTML = `
                    <button type="button" onclick="triggerSearch(${pageNo - 1})" class="btn btn-outline-primary btn-sm">
                        &laquo; Previous
                    </button>
                `;
            } else {
                prevPageBtn.innerHTML = '';
            }

            if (hasNext) {
                nextPageBtn.innerHTML = `
                    <button type="button" onclick="triggerSearch(${pageNo + 1})" class="btn btn-outline-primary btn-sm">
                        Next &raquo;
                    </button>
                `;
            } else {
                nextPageBtn.innerHTML = '';
            }
        }

        // Utility to escape HTML to prevent XSS
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }
    </script>
}