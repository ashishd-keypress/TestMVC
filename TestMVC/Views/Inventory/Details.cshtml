@model TestMVC.Models.DeviceUnit
@{
    ViewData["Title"] = "Device Details";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-phone text-primary me-2"></i>Device Information
                    </h5>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back to Inventory
                    </a>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4 text-center">
                        <h3 class="fw-bold mb-1">@Model.ProductName</h3>
                        <div class="text-muted">
                            <span class="badge bg-secondary-subtle text-secondary me-2">@Model.Brand</span>
                            <span>@(Model.RAM ?? "-") / @(Model.Storage ?? "-") &bull; Color: @(Model.Color ?? "-")</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 rounded bg-light border">
                                <label class="small text-muted d-block mb-1">Primary IMEI (IMEI 1)</label>
                                <code class="fs-5 fw-bold text-dark">@Model.IMEI1</code>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 rounded bg-light border">
                                <label class="small text-muted d-block mb-1">Secondary IMEI (IMEI 2)</label>
                                <code class="fs-5 fw-bold text-dark">@(string.IsNullOrEmpty(Model.IMEI2) ? "-" : Model.IMEI2)</code>
                            </div>
                        </div>
                    </div>

                    <div class="row gy-3 mb-4">
                        <div class="col-6">
                            <label class="small text-muted d-block">Current Status</label>
                            <span class="badge-status-pill badge-status-active mt-1">@Model.StatusName</span>
                        </div>
                        <div class="col-6">
                            <label class="small text-muted d-block">Serial Number</label>
                            <span class="fw-semibold">@(string.IsNullOrEmpty(Model.SerialNumber) ? "-" : Model.SerialNumber)</span>
                        </div>
                        <div class="col-6">
                            <label class="small text-muted d-block">Cost Price</label>
                            <span class="fw-semibold">₹@((Model.CostPrice ?? 0).ToString("N2"))</span>
                        </div>
                        <div class="col-6">
                            <label class="small text-muted d-block">Selling Price</label>
                            <span class="fw-bold text-primary fs-5">₹@((Model.SellingPrice ?? 0).ToString("N2"))</span>
                        </div>
                        <div class="col-6">
                            <label class="small text-muted d-block">Warranty Start</label>
                            <span class="fw-semibold">@(Model.WarrantyStartDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                        </div>
                        <div class="col-6">
                            <label class="small text-muted d-block">Warranty End</label>
                            <span class="fw-semibold">@(Model.WarrantyEndDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                        </div>
                        <div class="col-12">
                            <label class="small text-muted d-block">Notes</label>
                            <span class="text-muted">@(string.IsNullOrEmpty(Model.Notes) ? "None" : Model.Notes)</span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Status Changer Form -->
                    <h6 class="fw-bold mb-3">Update Device Status</h6>
                    <form asp-action="UpdateStatus" method="post" class="row g-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.DeviceUnitId" />
                        
                        <div class="col-md-5">
                            <select name="status" class="form-select">
                                <option value="1" selected="@(Model.CurrentStatus == 1)">1 - In Stock (Available)</option>
                                <option value="2" selected="@(Model.CurrentStatus == 2)">2 - Reserved</option>
                                <option value="3" selected="@(Model.CurrentStatus == 3)">3 - Sold</option>
                                <option value="4" selected="@(Model.CurrentStatus == 4)">4 - Returned</option>
                                <option value="5" selected="@(Model.CurrentStatus == 5)">5 - Under Repair</option>
                                <option value="6" selected="@(Model.CurrentStatus == 6)">6 - Damaged</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <input type="text" name="notes" class="form-control" placeholder="Optional remark/reason..." />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
