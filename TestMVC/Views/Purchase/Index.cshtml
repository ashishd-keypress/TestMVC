@model List<TestMVC.Models.Purchase>
@{
    ViewData["Title"] = "Purchases (Stock In)";
    string? search = ViewBag.Search;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.025em;">Purchases & Stock Inward</h2>
            <p class="text-muted small mb-0">Record incoming stock from mobile distributors and suppliers, register IMEI numbers.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-box-arrow-in-down"></i>
            <span>+ New Purchase Inward</span>
        </a>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" id="purchaseSearchForm" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="purchaseSearchInput" name="search" value="@search" class="form-control" placeholder="Search by Bill No, Supplier Name, Phone..." />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <button type="button" id="purchaseResetBtn" class="btn btn-outline-secondary">Reset</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Purchases Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle mb-0" id="purchaseTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;" class="text-center">Sr. No.</th>
                    <th>Bill / Invoice No.</th>
                    <th>Supplier Name</th>
                    <th>Date</th>
                    <th class="text-end">Total Amount</th>
                    <th class="text-end">Paid Amount</th>
                    <th class="text-end">Due Amount</th>
                    <th class="text-center" style="width: 120px;">Status</th>
                    <th class="text-center" style="width: 100px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-1 d-block mb-2 text-muted"></i>
                            <em>No purchase bills recorded yet. Click '+ New Purchase Inward' to stock phones.</em>
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    foreach (var p in Model)
                    {
                        <tr>
                            <td class="text-center text-muted fw-semibold">@index</td>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@p.PurchaseId" class="text-decoration-none">
                                    @p.InvoiceNumber
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@p.SupplierName</div>
                                <small class="text-muted">@p.SupplierPhone</small>
                            </td>
                            <td class="small text-muted">@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end fw-bold">₹@p.GrandTotal.ToString("N2")</td>
                            <td class="text-end text-success">₹@p.PaidAmount.ToString("N2")</td>
                            <td class="text-end @(p.DueAmount > 0 ? "text-danger fw-bold" : "text-muted")">
                                ₹@p.DueAmount.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success px-2 py-1">@p.Status</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@p.PurchaseId" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-info-circle me-1"></i> View
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('purchaseSearchForm');
            const input = document.getElementById('purchaseSearchInput');
            const resetBtn = document.getElementById('purchaseResetBtn');
            const tbody = document.querySelector('#purchaseTable tbody');

            async function searchPurchases(query) {
                try {
                    const res = await window.apiFetch(`/api/Purchase/purchase_list_get?search=${encodeURIComponent(query || '')}`, { method: 'GET' });
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    const json = await res.json();
                    if (!json || !json.success || !tbody) return;

                    if (!json.data || json.data.length === 0) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam fs-1 d-block mb-2 text-muted"></i>
                                    <em>${query ? `No purchase bills found matching "${escapeHtml(query)}".` : "No purchase bills recorded yet. Click '+ New Purchase Inward' to stock phones."}</em>
                                </td>
                            </tr>
                        `;
                    } else {
                        tbody.innerHTML = json.data.map((p, idx) => {
                            const dueClass = p.dueAmount > 0 ? 'text-danger fw-bold' : 'text-muted';
                            return `
                                <tr>
                                    <td class="text-center text-muted fw-semibold">${idx + 1}</td>
                                    <td class="fw-bold">
                                        <a href="/Purchase/Details/${p.purchaseId}" class="text-decoration-none">${escapeHtml(p.invoiceNumber || '')}</a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">${escapeHtml(p.supplierName || '')}</div>
                                        <small class="text-muted">${escapeHtml(p.supplierPhone || '')}</small>
                                    </td>
                                    <td class="small text-muted">${escapeHtml(p.purchaseDate || '')}</td>
                                    <td class="text-end fw-bold">₹${escapeHtml(p.grandTotalFormatted)}</td>
                                    <td class="text-end text-success">₹${escapeHtml(p.paidAmountFormatted)}</td>
                                    <td class="text-end ${dueClass}">₹${escapeHtml(p.dueAmountFormatted)}</td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success px-2 py-1">${escapeHtml(p.status || '')}</span>
                                    </td>
                                    <td class="text-center">
                                        <a href="/Purchase/Details/${p.purchaseId}" class="btn btn-sm btn-outline-primary" title="View Details">
                                            <i class="bi bi-info-circle me-1"></i> View
                                        </a>
                                    </td>
                                </tr>
                            `;
                        }).join('');
                    }

                    const newUrl = query ? `/Purchase?search=${encodeURIComponent(query)}` : '/Purchase';
                    window.history.replaceState({ path: newUrl }, '', newUrl);
                } catch (err) {
                    console.error('Purchase search API error:', err);
                    showToast('Error searching purchases: ' + err.message, 'error');
                }
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    searchPurchases(input ? input.value.trim() : '');
                });
            }
            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    if (input) input.value = '';
                    searchPurchases('');
                });
            }
        })();
    </script>
}
