@model TestMVC.Models.Expense
@{
    ViewData["Title"] = "Record Expense";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-wallet2 text-primary me-2"></i>Record Shop Expense
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ExpenseCategoryId" class="form-label fw-semibold">Expense Category <span class="text-danger">*</span></label>
                                <select asp-for="ExpenseCategoryId" asp-items="ViewBag.Categories" class="form-select">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="ExpenseCategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExpenseDate" class="form-label fw-semibold">Expense Date <span class="text-danger">*</span></label>
                                <input asp-for="ExpenseDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpenseDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-semibold">Amount (₹) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PaymentMethodId" class="form-label fw-semibold">Payment Mode</label>
                                <select asp-for="PaymentMethodId" asp-items="ViewBag.PaymentMethods" class="form-select">
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Expense Description / Purpose <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="e.g. October Shop Rent, Electricity Bill, Staff Lunch"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to Expenses</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Expense
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
