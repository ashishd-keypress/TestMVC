@model List<TestMVC.Models.Customer>
@{
    ViewData["Title"] = "Customers Directory";
    string? search = ViewBag.Search;
}

<form id="customerAntiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.025em;">Customers Directory</h2>
            <p class="text-muted small mb-0">Manage customer records, contact numbers, GST numbers, and ledger dues.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Add Customer
        </a>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name, phone, GST, email..." />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle mb-0" id="customerTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;" class="text-center">Sr. No.</th>
                    <th>Customer Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>GSTIN</th>
                    <th class="text-end">Due Balance</th>
                    <th class="text-center" style="width: 100px;">Status</th>
                    <th class="text-center" style="width: 175px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr id="noRecordsRow">
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-muted"></i>
                            <em>No customers registered yet.</em>
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    foreach (var c in Model)
                    {
                        <tr data-customer-id="@c.CustomerId">
                            <td class="text-center text-muted fw-semibold">@index</td>
                            <td class="fw-bold">@c.CustomerName</td>
                            <td><a href="tel:@c.Phone" class="text-decoration-none">@c.Phone</a></td>
                            <td class="text-muted">@(string.IsNullOrEmpty(c.Email) ? "-" : c.Email)</td>
                            <td><small class="text-muted">@(string.IsNullOrEmpty(c.GSTNumber) ? "-" : c.GSTNumber)</small></td>
                            <td class="text-end @(c.CurrentBalance > 0 ? "text-danger fw-bold" : "text-muted")">
                                ₹@c.CurrentBalance.ToString("N2")
                            </td>
                            <td class="text-center">
                                @if (c.IsActive)
                                {
                                    <button type="button" class="btn btn-sm btn-status-on px-2 py-1" onclick="toggleStatus('Customer', @c.CustomerId, this)" title="Click to turn OFF (Inactive)">
                                        <i class="bi bi-toggle-on me-1"></i> ON
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-status-off px-2 py-1" onclick="toggleStatus('Customer', @c.CustomerId, this)" title="Click to turn ON (Active)">
                                        <i class="bi bi-toggle-off me-1"></i> OFF
                                    </button>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-2 justify-content-center align-items-center">
                                    <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-sm btn-outline-primary" title="Edit Customer @c.CustomerName">
                                        <i class="bi bi-pencil-square me-1"></i>Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteCustomer(@c.CustomerId, '@Html.Raw(c.CustomerName.Replace("'", "\\'"))', this.closest('tr'))" title="Delete Customer @c.CustomerName">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
