@model List<TestMVC.Models.Brand>
@{
    ViewData["Title"] = "Brands";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Brands</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add Brand
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 80px;" class="text-center">ID</th>
                    <th scope="col">Brand Name</th>
                    <th scope="col" class="text-center" style="width: 110px;">Status</th>
                    <th scope="col" style="width: 200px;">Created Date</th>
                    <th scope="col" style="width: 170px;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <em>No brands found.</em>
                        </td>
                    </tr>
                }
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="fw-bold text-center">@b.BrandId</td>
                        <td>
                            <span class="badge bg-secondary text-white fs-6">@b.BrandName</span>
                        </td>
                        <td class="text-center">
                            @if (b.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-status-on px-2 py-1" onclick="toggleStatus('Brand', @b.BrandId, this)" title="Click to turn OFF (Inactive)">
                                    <i class="bi bi-toggle-on me-1"></i> ON
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-status-off px-2 py-1" onclick="toggleStatus('Brand', @b.BrandId, this)" title="Click to turn ON (Active)">
                                    <i class="bi bi-toggle-off me-1"></i> OFF
                                </button>
                            }
                        </td>
                        <td>
                            @(b.CreatedDate.HasValue ? b.CreatedDate.Value.ToString("yyyy-MM-dd HH:mm") : "-")
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@b.BrandId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('Brand', @b.BrandId, '@b.BrandName.Replace("'", "\\'") ', this.closest('tr'))" title="Delete">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
