@model TestMVC.Models.Customer
@{
    ViewData["Title"] = "Edit Customer";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header border-bottom py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square text-primary me-2"></i>Edit Customer
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CustomerId" />
                        <input type="hidden" asp-for="CurrentBalance" />
                        <input type="hidden" asp-for="CreatedDate" />

                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label fw-semibold">Customer Full Name <span class="text-danger">*</span></label>
                            <input asp-for="CustomerName" class="form-control" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold">Mobile Number <span class="text-danger">*</span></label>
                                <input asp-for="Phone" 
                                       type="tel" 
                                       inputmode="numeric" 
                                       pattern="[0-9]{10,15}" 
                                       maxlength="15" 
                                       class="form-control" 
                                       placeholder="e.g. 9876543210" 
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="GSTNumber" class="form-label fw-semibold">GSTIN / Tax No</label>
                                <input asp-for="GSTNumber" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OpeningBalance" class="form-label fw-semibold">Opening Balance (₹)</label>
                                <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="custActiveSwitch" />
                                <label class="form-check-label fw-semibold" for="custActiveSwitch">Active Status</label>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to Customers</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Update Customer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
