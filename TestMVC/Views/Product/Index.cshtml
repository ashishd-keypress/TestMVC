@model List<TestMVC.Models.Product>
@{
    ViewData["Title"] = "Products";
    int pageNo = ViewBag.PageNo ?? 1;
    string? search = ViewBag.Search;
    bool hasNext = ViewBag.HasNext != null && (bool)ViewBag.HasNext;
}

<!-- Hidden AntiForgeryToken for dynamic delete actions -->
<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.025em;">Products & Mobile Catalog</h2>
            <p class="text-muted small mb-0">Complete mobile catalog, specifications, live stock, and pricing directory.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Product
            </a>
            <a asp-controller="Purchase" asp-action="Create" class="btn btn-action-brand shadow-sm">
                <i class="bi bi-box-arrow-in-down me-1"></i> Purchase Stock In
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="searchForm" method="get" class="row g-2 align-items-center" onsubmit="event.preventDefault(); triggerSearch(1);">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="searchInput"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Type to search (e.g. iPhone, Samsung, 256GB, Black)..."
                               autocomplete="off" />
                        <span class="input-group-text" id="searchSpinner" style="display: none;">
                            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                        </span>
                        <button type="button"
                                id="btnClearSearch"
                                class="btn btn-outline-secondary"
                                style="@(string.IsNullOrEmpty(search) ? "display:none;" : "")"
                                title="Clear Search">
                            ✕
                        </button>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-primary" onclick="triggerSearch(1)">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 60px;" class="text-center">Sr. No.</th>
                    <th scope="col" style="width: 75px;" class="text-center">Image</th>
                    <th scope="col">Product / Model Name</th>
                    <th scope="col">Brand</th>
                    <th scope="col">Category</th>
                    <th scope="col" class="text-end">Selling Price</th>
                    <th scope="col" class="text-center">Stock</th>
                    <th scope="col" class="text-center" style="width: 100px;">Status</th>
                    <th scope="col">Created Date</th>
                    <th scope="col" style="width: 185px;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                @if (Model.Count == 0)
                {
                    <tr id="noRecordsRow">
                        <td colspan="10" class="text-center py-4 text-muted">
                            <em>No products found.</em>
                        </td>
                    </tr>
                }
                @{ int serialNo = (pageNo - 1) * 10 + 1; }
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-bold text-center">@(serialNo++)</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(p.Image ?? p.ImageUrl))
                            {
                                <a asp-action="Details" asp-route-id="@p.ProductId" title="View Details">
                                    <img src="@(p.Image ?? p.ImageUrl)" alt="@p.Name" class="table-img-thumb" onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'table-img-placeholder\'><i class=\'bi bi-image\'></i></div>';" />
                                </a>
                            }
                            else
                            {
                                <div class="table-img-placeholder" title="No Image">
                                    <i class="bi bi-image"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@p.ProductId" class="text-decoration-none fw-semibold">@p.Name</a>
                            @if (!string.IsNullOrEmpty(p.RAM) || !string.IsNullOrEmpty(p.Storage))
                            {
                                <div class="small text-muted">
                                    <span>@p.RAM / @p.Storage</span>
                                    @if (!string.IsNullOrEmpty(p.Color)) { <span>&bull; @p.Color</span> }
                                </div>
                            }
                        </td>
                        <td>@(!string.IsNullOrEmpty(p.Brand) ? Html.Raw("<span class=\"badge-brand\">" + p.Brand + "</span>") : Html.Raw("-"))</td>
                        <td>
                            @if (!string.IsNullOrEmpty(p.Category))
                            {
                                <span class="badge-category">@p.Category</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td class="text-end fw-semibold">
                            <span class="badge-price">₹@p.Price.ToString("N2")</span>
                            @if (p.MRP.HasValue && p.MRP.Value > p.Price)
                            {
                                <div class="small text-muted text-decoration-line-through">₹@p.MRP.Value.ToString("N2")</div>
                            }
                        </td>
                        <td class="text-center">
                            @if (p.StockQuantity > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    @p.StockQuantity in stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                    0 in stock
                                </span>
                            }
                            @if (p.TrackIMEI)
                            {
                                <div class="mt-1">
                                    <span class="badge bg-primary-subtle text-primary small">IMEI Tracked</span>
                                </div>
                            }
                        </td>
                        <td class="text-center">
                            @if (p.IsActive)
                            {
                                <button type="button" class="btn btn-sm btn-status-on px-2 py-1" onclick="toggleStatus('Product', @p.ProductId, this)" title="Click to turn OFF (Inactive)">
                                    <i class="bi bi-toggle-on me-1"></i> ON
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-status-off px-2 py-1" onclick="toggleStatus('Product', @p.ProductId, this)" title="Click to turn ON (Active)">
                                    <i class="bi bi-toggle-off me-1"></i> OFF
                                </button>
                            }
                        </td>
                        <td>
                            @(p.CreatedDate.HasValue ? p.CreatedDate.Value.ToString("yyyy-MM-dd hh:mm tt") : "-")
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="Details" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-info" title="View Details">
                                    View
                                </a>
                                <a asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('Product', @p.ProductId, '@p.Name.Replace("'", "\\'")', this.closest('tr'))" title="Delete">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="paginationContainer" class="d-flex justify-content-between align-items-center mt-3">
        <div id="prevPageBtn">
            @if (pageNo > 1)
            {
                <button type="button" onclick="triggerSearch(@(pageNo - 1))" class="btn btn-outline-primary btn-sm">
                    &laquo; Previous
                </button>
            }
        </div>
        <div id="pageInfo" class="text-muted small">
            Page <span id="currentPageSpan">@pageNo</span>
        </div>
        <div id="nextPageBtn">
            @if (hasNext)
            {
                <button type="button" onclick="triggerSearch(@(pageNo + 1))" class="btn btn-outline-primary btn-sm">
                    Next &raquo;
                </button>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let searchTimeout = null;
        let currentPage = @pageNo;

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        document.getElementById('searchInput').addEventListener('input', function (e) {
            const val = e.target.value.trim();
            const btnClear = document.getElementById('btnClearSearch');
            btnClear.style.display = val.length > 0 ? 'inline-block' : 'none';

            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                triggerSearch(1);
            }, 300);
        });

        document.getElementById('btnClearSearch').addEventListener('click', function () {
            const input = document.getElementById('searchInput');
            input.value = '';
            this.style.display = 'none';
            triggerSearch(1);
        });

        async function triggerSearch(targetPage) {
            currentPage = targetPage;
            const query = document.getElementById('searchInput').value.trim();
            const spinner = document.getElementById('searchSpinner');

            try {
                if (spinner) spinner.style.display = 'inline-block';

                const url = `/Product/SearchApi?search=${encodeURIComponent(query)}&pageNo=${targetPage}`;
                const response = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) throw new Error('Search failed');

                const result = await response.json();
                if (result.success) {
                    renderProducts(result.data, query);
                    renderPagination(result.pageNo, result.hasNext);

                    const newUrl = query
                        ? `/Product?search=${encodeURIComponent(query)}&pageNo=${targetPage}`
                        : `/Product?pageNo=${targetPage}`;
                    window.history.replaceState({ path: newUrl }, '', newUrl);
                }
            } catch (err) {
                console.error('Error fetching search results:', err);
            } finally {
                if (spinner) spinner.style.display = 'none';
            }
        }

        function renderProducts(products, query) {
            const tableBody = document.getElementById('productTableBody');
            if (!tableBody) return;

            if (!products || products.length === 0) {
                const message = query ? `No products found matching "${escapeHtml(query)}".` : 'No products found.';
                tableBody.innerHTML = `
                    <tr id="noRecordsRow">
                        <td colspan="10" class="text-center py-4 text-muted">
                            <em>${message}</em>
                        </td>
                    </tr>
                `;
                return;
            }

            const startIndex = (currentPage - 1) * 10 + 1;
            let html = '';
            products.forEach((p, index) => {
                const serialNo = startIndex + index;
                const brand = p.brand ? `<span class="badge-brand">${escapeHtml(p.brand)}</span>` : '-';
                const categoryBadge = p.category
                    ? `<span class="badge-category">${escapeHtml(p.category)}</span>`
                    : '<span>-</span>';
                const formattedPrice = Number(p.price).toLocaleString('en-IN', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                const date = p.createdDate || '-';
                const name = escapeHtml(p.name);
                const safeNameForConfirm = name.replace(/'/g, "\\'");

                const productImg = p.image || p.imageUrl;
                const imgHtml = productImg
                    ? `<a href="/Product/Details/${p.productId}" title="View Details"><img src="${escapeHtml(productImg)}" alt="${escapeHtml(name)}" class="table-img-thumb" onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\\'table-img-placeholder\\'><i class=\\'bi bi-image\\'></i></div>';" /></a>`
                    : `<div class="table-img-placeholder" title="No Image"><i class="bi bi-image"></i></div>`;

                const stockHtml = p.stockQuantity > 0 
                    ? `<span class="badge bg-success-subtle text-success border border-success-subtle">${p.stockQuantity} in stock</span>`
                    : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle">0 in stock</span>`;

                const imeiBadge = p.trackImei ? `<div class="mt-1"><span class="badge bg-primary-subtle text-primary small">IMEI Tracked</span></div>` : '';

                const specsHtml = (p.ram || p.storage)
                    ? `<div class="small text-muted">${escapeHtml(p.ram || '')}/${escapeHtml(p.storage || '')} ${p.color ? '&bull; ' + escapeHtml(p.color) : ''}</div>`
                    : '';

                const statusBtn = p.isActive
                    ? `<button type="button" class="btn btn-sm btn-status-on px-2 py-1" onclick="toggleStatus('Product', ${p.productId}, this)" title="Click to turn OFF (Inactive)">
                        <i class="bi bi-toggle-on me-1"></i> ON
                       </button>`
                    : `<button type="button" class="btn btn-sm btn-status-off px-2 py-1" onclick="toggleStatus('Product', ${p.productId}, this)" title="Click to turn ON (Active)">
                        <i class="bi bi-toggle-off me-1"></i> OFF
                       </button>`;

                html += `
                    <tr>
                        <td class="fw-bold text-center">${serialNo}</td>
                        <td class="text-center">${imgHtml}</td>
                        <td>
                            <a href="/Product/Details/${p.productId}" class="text-decoration-none fw-semibold">${name}</a>
                            ${specsHtml}
                        </td>
                        <td>${brand}</td>
                        <td>${categoryBadge}</td>
                        <td class="text-end fw-semibold"><span class="badge-price">₹${formattedPrice}</span></td>
                        <td class="text-center">${stockHtml}${imeiBadge}</td>
                        <td class="text-center">${statusBtn}</td>
                        <td>${date}</td>
                        <td class="text-center">
                            <div class="d-flex gap-2 justify-content-center">
                                <a href="/Product/Details/${p.productId}" class="btn btn-sm btn-outline-info" title="View Details">
                                    View
                                </a>
                                <a href="/Product/Edit/${p.productId}" class="btn btn-sm btn-outline-primary" title="Edit">
                                    Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteItem('Product', ${p.productId}, '${safeNameForConfirm}', this.closest('tr'))" title="Delete">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });

            tableBody.innerHTML = html;
        }

        function renderPagination(page, hasNext) {
            currentPage = page;
            const pageSpan = document.getElementById('currentPageSpan');
            if (pageSpan) pageSpan.innerText = page;

            const prevBtnContainer = document.getElementById('prevPageBtn');
            const nextBtnContainer = document.getElementById('nextPageBtn');

            if (prevBtnContainer) {
                prevBtnContainer.innerHTML = page > 1
                    ? `<button type="button" onclick="triggerSearch(${page - 1})" class="btn btn-outline-primary btn-sm">&laquo; Previous</button>`
                    : '';
            }

            if (nextBtnContainer) {
                nextBtnContainer.innerHTML = hasNext
                    ? `<button type="button" onclick="triggerSearch(${page + 1})" class="btn btn-outline-primary btn-sm">Next &raquo;</button>`
                    : '';
            }
        }
    </script>
}
