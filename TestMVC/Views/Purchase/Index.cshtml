@model List<TestMVC.Models.Purchase>
@{
    ViewData["Title"] = "Purchases (Stock In)";
    string? search = ViewBag.Search;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.025em;">Purchases & Stock Inward</h2>
            <p class="text-muted small mb-0">Record incoming stock from mobile distributors and suppliers, register IMEI numbers.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-box-arrow-in-down"></i>
            <span>+ New Purchase Inward</span>
        </a>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by Bill No, Supplier Name, Phone..." />
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Purchases Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;" class="text-center">Sr. No.</th>
                    <th>Bill / Invoice No.</th>
                    <th>Supplier Name</th>
                    <th>Date</th>
                    <th class="text-end">Total Amount</th>
                    <th class="text-end">Paid Amount</th>
                    <th class="text-end">Due Amount</th>
                    <th class="text-center" style="width: 120px;">Status</th>
                    <th class="text-center" style="width: 100px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-1 d-block mb-2 text-muted"></i>
                            <em>No purchase bills recorded yet. Click '+ New Purchase Inward' to stock phones.</em>
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    foreach (var p in Model)
                    {
                        <tr>
                            <td class="text-center text-muted fw-semibold">@index</td>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@p.PurchaseId" class="text-decoration-none">
                                    @p.InvoiceNumber
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold">@p.SupplierName</div>
                                <small class="text-muted">@p.SupplierPhone</small>
                            </td>
                            <td class="small text-muted">@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end fw-bold">₹@p.GrandTotal.ToString("N2")</td>
                            <td class="text-end text-success">₹@p.PaidAmount.ToString("N2")</td>
                            <td class="text-end @(p.DueAmount > 0 ? "text-danger fw-bold" : "text-muted")">
                                ₹@p.DueAmount.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success px-2 py-1">@p.Status</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@p.PurchaseId" class="btn btn-sm btn-outline-primary" title="View Details">
                                    <i class="bi bi-info-circle me-1"></i> View
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
